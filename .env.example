# Staging must use sandbox with a Paddle test client-side token.
COVE_SITE_ENV=sandbox
COVE_PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_side_token

# The static GitHub Pages build also requires one price ID for each plan.
COVE_MONTHLY_PRICE_ID=pri_replace_with_monthly_price_id
COVE_ANNUAL_PRICE_ID=pri_replace_with_annual_price_id
